generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGRONOMIST
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGRONOMIST)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdPlants Plant[] @relation("PlantCreatedBy")
  updatedPlants Plant[] @relation("PlantUpdatedBy")
  createdDiseases Disease[] @relation("DiseaseCreatedBy")
  updatedDiseases Disease[] @relation("DiseaseUpdatedBy")

  @@index([active])
  @@index([role])
}

enum KnowledgeEntityType {
  PLANT
  DISEASE
  PEST
  DEFICIENCY
  PRODUCT
}

enum KnowledgePublicationState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KnowledgeReleaseStatus {
  GENERATING
  ACTIVE
  FAILED
  SUPERSEDED
}

enum PlantCategory {
  CROP
  HOME_PLANT
  ORNAMENTAL
}

enum KnowledgeSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum StorageCleanupStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DiseaseClassification {
  FUNGAL
  BACTERIAL
  VIRAL
  OOMYCETE
  PHYSIOLOGICAL_DISORDER
}
enum DiseaseSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}
enum PlantDiseaseSusceptibility {
  LOW
  MEDIUM
  HIGH
}
enum PlantDiseaseRelationshipType {
  HOST
  COMMON_HOST
  OCCASIONAL_HOST
}

model Plant {
  id              String        @id
  category        PlantCategory
  scientificName  String?
  description     String?
  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  entity          KnowledgeEntity @relation(fields: [id], references: [id], onDelete: Restrict)
  createdBy       User          @relation("PlantCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User?         @relation("PlantUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  aliases         PlantAlias[]
  images          PlantImage[]
  syncState       PlantKnowledgeSync?
  diseases        PlantDisease[]

  @@index([category])
  @@index([createdByUserId])
}

model Disease {
  id String @id
  classification DiseaseClassification
  severity DiseaseSeverity
  scientificName String?
  pathogenGenus String?
  pathogenSpecies String?
  lifecycle String?
  createdByUserId String
  updatedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entity KnowledgeEntity @relation(fields: [id], references: [id], onDelete: Restrict)
  createdBy User @relation("DiseaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy User? @relation("DiseaseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  aliases DiseaseAlias[]
  symptoms DiseaseSymptom[]
  causes DiseaseCause[]
  plantParts DiseasePlantPart[]
  riskFactors DiseaseRiskFactor[]
  plants PlantDisease[]
  images DiseaseImage[]
  syncState DiseaseKnowledgeSync?
  @@index([classification])
  @@index([severity])
  @@index([createdByUserId])
}
model DiseaseAlias {
 id String @id @default(cuid())
 diseaseId String
 value String
 normalizedValue String
 locale String?
 disease Disease @relation(fields:[diseaseId],references:[id],onDelete:Cascade)
 @@unique([diseaseId,normalizedValue])
 @@index([normalizedValue])
}
model DiseaseSymptom {
 id String @id @default(cuid())
 diseaseId String
 value String
 normalizedValue String
 disease Disease @relation(fields:[diseaseId],references:[id],onDelete:Cascade)
 @@unique([diseaseId,normalizedValue])
 @@index([normalizedValue])
}
model DiseaseCause {
 id String @id @default(cuid())
 diseaseId String
 value String
 normalizedValue String
 disease Disease @relation(fields:[diseaseId],references:[id],onDelete:Cascade)
 @@unique([diseaseId,normalizedValue])
 @@index([normalizedValue])
}
model DiseasePlantPart {
 id String @id @default(cuid())
 diseaseId String
 value String
 normalizedValue String
 disease Disease @relation(fields:[diseaseId],references:[id],onDelete:Cascade)
 @@unique([diseaseId,normalizedValue])
 @@index([normalizedValue])
}
model DiseaseRiskFactor {
 id String @id @default(cuid())
 diseaseId String
 value String
 normalizedValue String
 disease Disease @relation(fields:[diseaseId],references:[id],onDelete:Cascade)
 @@unique([diseaseId,normalizedValue])
 @@index([normalizedValue])
}
model PlantDisease {
 plantId String
 diseaseId String
 susceptibility PlantDiseaseSusceptibility
 relationshipType PlantDiseaseRelationshipType
 notes String?
 plant Plant @relation(fields:[plantId],references:[id],onDelete:Cascade)
 disease Disease @relation(fields:[diseaseId],references:[id],onDelete:Cascade)
 @@id([plantId,diseaseId])
 @@index([diseaseId])
}
model DiseaseImage {
 id String @id @default(cuid())
 diseaseId String
 storageKey String @unique
 url String
 alt String
 contentType String
 fileSize Int
 width Int
 height Int
 checksum String
 sortOrder Int
 createdAt DateTime @default(now())
 disease Disease @relation(fields:[diseaseId],references:[id],onDelete:Cascade)
 @@unique([diseaseId,sortOrder])
}
model DiseaseKnowledgeSync {
 diseaseId String @id
 status KnowledgeSyncStatus @default(PENDING)
 lastSyncedAt DateTime?
 diagnosticCode String?
 updatedAt DateTime @updatedAt
 disease Disease @relation(fields:[diseaseId],references:[id],onDelete:Cascade)
 @@index([status])
}

model PlantAlias {
  id              String @id @default(cuid())
  plantId         String
  value           String
  normalizedValue String
  locale          String?
  plant           Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)
  @@unique([plantId, normalizedValue])
  @@index([normalizedValue])
}

model PlantImage {
  id          String @id @default(cuid())
  plantId     String
  storageKey  String @unique
  url         String
  alt         String
  contentType String
  fileSize    Int
  width       Int
  height      Int
  checksum    String
  sortOrder   Int
  createdAt   DateTime @default(now())
  plant       Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
  @@unique([plantId, sortOrder])
}

model PlantKnowledgeSync {
  plantId        String @id
  status         KnowledgeSyncStatus @default(PENDING)
  lastSyncedAt   DateTime?
  diagnosticCode String?
  updatedAt      DateTime @updatedAt
  plant          Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
  @@index([status])
}

model StorageCleanupJob {
  id          String @id @default(cuid())
  storageKey  String @unique
  status      StorageCleanupStatus @default(PENDING)
  retryCount  Int @default(0)
  diagnosticCode String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
  @@index([status])
}

model KnowledgeEntity {
  id               String                    @id
  type             KnowledgeEntityType
  slug             String
  name             String
  payload          Json
  schemaVersion    Int
  publicationState KnowledgePublicationState @default(DRAFT)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  plant            Plant?
  disease          Disease?

  @@unique([type, slug])
  @@index([publicationState, type])
}

model KnowledgeRelease {
  id               String                 @id @default(cuid())
  version          String                 @unique
  generation       Int                    @unique
  status           KnowledgeReleaseStatus @default(GENERATING)
  contentChecksum  String?
  manifestChecksum String?                @unique
  failureReason    String?
  createdAt        DateTime               @default(now())
  activatedAt      DateTime?
  activeIn         KnowledgeGenerationLock? @relation("ActiveKnowledgeRelease")

  @@index([status])
  @@index([contentChecksum])
}

model KnowledgeGenerationLock {
  id               String            @id
  ownerToken       String?
  expiresAt        DateTime?
  latestGeneration Int               @default(0)
  activeReleaseId  String?           @unique
  updatedAt        DateTime          @updatedAt
  activeRelease    KnowledgeRelease? @relation("ActiveKnowledgeRelease", fields: [activeReleaseId], references: [id])
}
