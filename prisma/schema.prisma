generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGRONOMIST
}

model User {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  passwordHash        String?
  role                UserRole     @default(AGRONOMIST)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  createdPlants       Plant[]      @relation("PlantCreatedBy")
  updatedPlants       Plant[]      @relation("PlantUpdatedBy")
  createdDiseases     Disease[]    @relation("DiseaseCreatedBy")
  updatedDiseases     Disease[]    @relation("DiseaseUpdatedBy")
  createdPests        Pest[]       @relation("PestCreatedBy")
  updatedPests        Pest[]       @relation("PestUpdatedBy")
  createdDeficiencies Deficiency[] @relation("DeficiencyCreatedBy")
  updatedDeficiencies Deficiency[] @relation("DeficiencyUpdatedBy")
  createdProducts     Product[]    @relation("ProductCreatedBy")
  updatedProducts     Product[]    @relation("ProductUpdatedBy")

  @@index([active])
  @@index([role])
}

enum KnowledgeEntityType {
  PLANT
  DISEASE
  PEST
  DEFICIENCY
  PRODUCT
}

enum KnowledgePublicationState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KnowledgeReleaseStatus {
  GENERATING
  ACTIVE
  FAILED
  SUPERSEDED
}

enum PlantCategory {
  CROP
  HOME_PLANT
  ORNAMENTAL
}

enum KnowledgeSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum StorageCleanupStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DiseaseClassification {
  FUNGAL
  BACTERIAL
  VIRAL
  OOMYCETE
  PHYSIOLOGICAL_DISORDER
}

enum DiseaseSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum PestClassification {
  INSECT
  MITE
  NEMATODE
  MOLLUSK
  RODENT
  OTHER
}

enum PestSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum PestEconomicImpact {
  LOW
  MODERATE
  HIGH
  SEVERE
}

enum NutrientClassification {
  MACRONUTRIENT
  SECONDARY_NUTRIENT
  MICRONUTRIENT
  BENEFICIAL_ELEMENT
  OTHER
}

enum NutrientMobility {
  MOBILE
  IMMOBILE
  CONTEXT_DEPENDENT
  UNKNOWN
}

enum PlantDeficiencySusceptibility {
  LOW
  MEDIUM
  HIGH
}

enum PlantDeficiencyRelationshipType {
  COMMON
  SUSCEPTIBLE
  OCCASIONAL
}

enum ProductImageOwnership {
  LEGACY_PUBLIC
  MANAGED_BLOB
  EXTERNAL
}

enum ProductImageFit {
  COVER
  CONTAIN
  FILL
  SCALE_DOWN
}

enum ProductImagePosition {
  CENTER
  TOP
  BOTTOM
  LEFT
  RIGHT
}

enum ProductRecommendationState {
  ACTIVE
  DISABLED
}

enum ProductRecommendationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ProductRecommendationTargetType {
  PLANT
  DISEASE
  PEST
  DEFICIENCY
}

enum PlantPestSusceptibility {
  LOW
  MEDIUM
  HIGH
}

enum PlantPestRelationshipType {
  PRIMARY_HOST
  SECONDARY_HOST
  OCCASIONAL_HOST
}

enum PlantDiseaseSusceptibility {
  LOW
  MEDIUM
  HIGH
}

enum PlantDiseaseRelationshipType {
  HOST
  COMMON_HOST
  OCCASIONAL_HOST
}

model Plant {
  id                     String                  @id
  category               PlantCategory
  scientificName         String?
  description            String?
  createdByUserId        String
  updatedByUserId        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  entity                 KnowledgeEntity         @relation(fields: [id], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("PlantCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy              User?                   @relation("PlantUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  aliases                PlantAlias[]
  images                 PlantImage[]
  syncState              PlantKnowledgeSync?
  diseases               PlantDisease[]
  pests                  PlantPest[]
  deficiencies           PlantDeficiency[]
  productRecommendations ProductRecommendation[]
  savedByCustomers       CustomerSavedPlant[]

  @@index([category])
  @@index([createdByUserId])
}

model Pest {
  id                     String                  @id
  classification         PestClassification
  severity               PestSeverity
  economicImpact         PestEconomicImpact
  scientificName         String?
  description            String?
  createdByUserId        String
  updatedByUserId        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  entity                 KnowledgeEntity         @relation(fields: [id], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("PestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy              User?                   @relation("PestUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  aliases                PestAlias[]
  symptoms               PestSymptom[]
  damagePatterns         PestDamagePattern[]
  lifecycleStages        PestLifecycleStage[]
  plants                 PlantPest[]
  images                 PestImage[]
  syncState              PestKnowledgeSync?
  productRecommendations ProductRecommendation[]

  @@index([classification])
  @@index([severity])
  @@index([economicImpact])
  @@index([createdByUserId])
}

model PestAlias {
  id              String  @id @default(cuid())
  pestId          String
  value           String
  normalizedValue String
  locale          String?
  pest            Pest    @relation(fields: [pestId], references: [id], onDelete: Cascade)

  @@unique([pestId, normalizedValue])
  @@index([normalizedValue])
}

model PestSymptom {
  id              String @id @default(cuid())
  pestId          String
  value           String
  normalizedValue String
  pest            Pest   @relation(fields: [pestId], references: [id], onDelete: Cascade)

  @@unique([pestId, normalizedValue])
  @@index([normalizedValue])
}

model PestDamagePattern {
  id              String @id @default(cuid())
  pestId          String
  value           String
  normalizedValue String
  pest            Pest   @relation(fields: [pestId], references: [id], onDelete: Cascade)

  @@unique([pestId, normalizedValue])
  @@index([normalizedValue])
}

model PestLifecycleStage {
  id              String @id @default(cuid())
  pestId          String
  value           String
  normalizedValue String
  sortOrder       Int
  pest            Pest   @relation(fields: [pestId], references: [id], onDelete: Cascade)

  @@unique([pestId, normalizedValue])
  @@unique([pestId, sortOrder])
}

model PlantPest {
  plantId          String
  pestId           String
  susceptibility   PlantPestSusceptibility
  relationshipType PlantPestRelationshipType
  seasonalContext  String?
  notes            String?
  plant            Plant                     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  pest             Pest                      @relation(fields: [pestId], references: [id], onDelete: Cascade)

  @@id([plantId, pestId])
  @@index([pestId])
}

model PestImage {
  id          String   @id @default(cuid())
  pestId      String
  storageKey  String   @unique
  url         String
  alt         String
  contentType String
  fileSize    Int
  width       Int
  height      Int
  checksum    String
  sortOrder   Int
  createdAt   DateTime @default(now())
  pest        Pest     @relation(fields: [pestId], references: [id], onDelete: Cascade)

  @@unique([pestId, sortOrder])
}

model PestKnowledgeSync {
  pestId         String              @id
  status         KnowledgeSyncStatus @default(PENDING)
  lastSyncedAt   DateTime?
  diagnosticCode String?
  updatedAt      DateTime            @updatedAt
  pest           Pest                @relation(fields: [pestId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Deficiency {
  id                     String                           @id
  nutrientCode           String                           @unique
  nutrientNameAr         String
  nutrientNameEn         String
  scientificName         String?
  classification         NutrientClassification
  mobility               NutrientMobility                 @default(UNKNOWN)
  description            String?
  soilContext            Json?
  phContext              Json?
  createdByUserId        String
  updatedByUserId        String?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  entity                 KnowledgeEntity                  @relation(fields: [id], references: [id], onDelete: Restrict)
  createdBy              User                             @relation("DeficiencyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy              User?                            @relation("DeficiencyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  aliases                DeficiencyAlias[]
  symptoms               DeficiencySymptom[]
  visualPatterns         DeficiencyVisualPattern[]
  causes                 DeficiencyCause[]
  aggravatingConditions  DeficiencyAggravatingCondition[]
  plants                 PlantDeficiency[]
  images                 DeficiencyImage[]
  syncState              DeficiencyKnowledgeSync?
  productRecommendations ProductRecommendation[]

  @@index([classification])
  @@index([mobility])
  @@index([createdByUserId])
}

model DeficiencyAlias {
  id              String     @id @default(cuid())
  deficiencyId    String
  value           String
  normalizedValue String
  locale          String?
  deficiency      Deficiency @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)

  @@unique([deficiencyId, normalizedValue])
  @@index([normalizedValue])
}

model DeficiencySymptom {
  id              String     @id @default(cuid())
  deficiencyId    String
  value           String
  normalizedValue String
  locations       String[]
  deficiency      Deficiency @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)

  @@unique([deficiencyId, normalizedValue])
  @@index([normalizedValue])
}

model DeficiencyVisualPattern {
  id              String     @id @default(cuid())
  deficiencyId    String
  value           String
  normalizedValue String
  deficiency      Deficiency @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)

  @@unique([deficiencyId, normalizedValue])
}

model DeficiencyCause {
  id              String     @id @default(cuid())
  deficiencyId    String
  value           String
  normalizedValue String
  deficiency      Deficiency @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)

  @@unique([deficiencyId, normalizedValue])
}

model DeficiencyAggravatingCondition {
  id              String     @id @default(cuid())
  deficiencyId    String
  value           String
  normalizedValue String
  deficiency      Deficiency @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)

  @@unique([deficiencyId, normalizedValue])
}

model PlantDeficiency {
  plantId          String
  deficiencyId     String
  susceptibility   PlantDeficiencySusceptibility
  relationshipType PlantDeficiencyRelationshipType
  notes            String?
  soilContext      Json?
  phContext        Json?
  plant            Plant                           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  deficiency       Deficiency                      @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)

  @@id([plantId, deficiencyId])
  @@index([deficiencyId])
}

model DeficiencyImage {
  id           String     @id @default(cuid())
  deficiencyId String
  storageKey   String     @unique
  url          String
  alt          String
  contentType  String
  fileSize     Int
  width        Int
  height       Int
  checksum     String
  sortOrder    Int
  createdAt    DateTime   @default(now())
  deficiency   Deficiency @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)

  @@unique([deficiencyId, sortOrder])
}

model DeficiencyKnowledgeSync {
  deficiencyId   String              @id
  status         KnowledgeSyncStatus @default(PENDING)
  lastSyncedAt   DateTime?
  diagnosticCode String?
  updatedAt      DateTime            @updatedAt
  deficiency     Deficiency          @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Disease {
  id                     String                  @id
  classification         DiseaseClassification
  severity               DiseaseSeverity
  scientificName         String?
  pathogenGenus          String?
  pathogenSpecies        String?
  lifecycle              String?
  createdByUserId        String
  updatedByUserId        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  entity                 KnowledgeEntity         @relation(fields: [id], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("DiseaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy              User?                   @relation("DiseaseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  aliases                DiseaseAlias[]
  symptoms               DiseaseSymptom[]
  causes                 DiseaseCause[]
  plantParts             DiseasePlantPart[]
  riskFactors            DiseaseRiskFactor[]
  plants                 PlantDisease[]
  images                 DiseaseImage[]
  syncState              DiseaseKnowledgeSync?
  productRecommendations ProductRecommendation[]

  @@index([classification])
  @@index([severity])
  @@index([createdByUserId])
}

model DiseaseAlias {
  id              String  @id @default(cuid())
  diseaseId       String
  value           String
  normalizedValue String
  locale          String?
  disease         Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@unique([diseaseId, normalizedValue])
  @@index([normalizedValue])
}

model DiseaseSymptom {
  id              String  @id @default(cuid())
  diseaseId       String
  value           String
  normalizedValue String
  disease         Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@unique([diseaseId, normalizedValue])
  @@index([normalizedValue])
}

model DiseaseCause {
  id              String  @id @default(cuid())
  diseaseId       String
  value           String
  normalizedValue String
  disease         Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@unique([diseaseId, normalizedValue])
  @@index([normalizedValue])
}

model DiseasePlantPart {
  id              String  @id @default(cuid())
  diseaseId       String
  value           String
  normalizedValue String
  disease         Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@unique([diseaseId, normalizedValue])
  @@index([normalizedValue])
}

model DiseaseRiskFactor {
  id              String  @id @default(cuid())
  diseaseId       String
  value           String
  normalizedValue String
  disease         Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@unique([diseaseId, normalizedValue])
  @@index([normalizedValue])
}

model PlantDisease {
  plantId          String
  diseaseId        String
  susceptibility   PlantDiseaseSusceptibility
  relationshipType PlantDiseaseRelationshipType
  notes            String?
  plant            Plant                        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  disease          Disease                      @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@id([plantId, diseaseId])
  @@index([diseaseId])
}

model DiseaseImage {
  id          String   @id @default(cuid())
  diseaseId   String
  storageKey  String   @unique
  url         String
  alt         String
  contentType String
  fileSize    Int
  width       Int
  height      Int
  checksum    String
  sortOrder   Int
  createdAt   DateTime @default(now())
  disease     Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@unique([diseaseId, sortOrder])
}

model DiseaseKnowledgeSync {
  diseaseId      String              @id
  status         KnowledgeSyncStatus @default(PENDING)
  lastSyncedAt   DateTime?
  diagnosticCode String?
  updatedAt      DateTime            @updatedAt
  disease        Disease             @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PlantAlias {
  id              String  @id @default(cuid())
  plantId         String
  value           String
  normalizedValue String
  locale          String?
  plant           Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, normalizedValue])
  @@index([normalizedValue])
}

model PlantImage {
  id          String   @id @default(cuid())
  plantId     String
  storageKey  String   @unique
  url         String
  alt         String
  contentType String
  fileSize    Int
  width       Int
  height      Int
  checksum    String
  sortOrder   Int
  createdAt   DateTime @default(now())
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, sortOrder])
}

model PlantKnowledgeSync {
  plantId        String              @id
  status         KnowledgeSyncStatus @default(PENDING)
  lastSyncedAt   DateTime?
  diagnosticCode String?
  updatedAt      DateTime            @updatedAt
  plant          Plant               @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([status])
}

model StorageCleanupJob {
  id             String               @id @default(cuid())
  storageKey     String               @unique
  status         StorageCleanupStatus @default(PENDING)
  retryCount     Int                  @default(0)
  diagnosticCode String?
  createdAt      DateTime             @default(now())
  completedAt    DateTime?
  updatedAt      DateTime             @updatedAt

  @@index([status])
}

model KnowledgeEntity {
  id               String                    @id
  type             KnowledgeEntityType
  slug             String
  name             String
  payload          Json
  schemaVersion    Int
  publicationState KnowledgePublicationState @default(DRAFT)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  plant            Plant?
  disease          Disease?
  pest             Pest?
  deficiency       Deficiency?
  product          Product?
  provenance       KnowledgeProvenance[]

  @@unique([type, slug])
  @@index([publicationState, type])
}

enum KnowledgeSourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KnowledgeReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KnowledgeImportStatus {
  DRAFT
  VALIDATED
  APPROVED
  IMPORTED
  ROLLED_BACK
  FAILED
}

model KnowledgeSource {
  id                      String                @id
  publisher               String
  url                     String
  contentType             String
  license                 String
  commercialUseAllowed    Boolean
  attributionRequirements String?
  modificationAllowed     Boolean
  redistributionAllowed   Boolean
  reviewDate              DateTime
  status                  KnowledgeSourceStatus @default(PENDING)
  reviewerNotes           String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  provenance              KnowledgeProvenance[]

  @@index([status])
}

model KnowledgeImportBatch {
  id           String                @id
  version      String
  status       KnowledgeImportStatus @default(DRAFT)
  report       Json?
  approvedBy   String?
  approvedAt   DateTime?
  importedAt   DateTime?
  rolledBackAt DateTime?
  createdAt    DateTime              @default(now())
  items        KnowledgeImportItem[]

  @@unique([version])
  @@index([status])
}

model KnowledgeImportItem {
  id         String                @id @default(cuid())
  batchId    String
  entityType KnowledgeEntityType
  entityId   String
  payload    Json
  status     KnowledgeImportStatus @default(DRAFT)
  diagnostic String?
  batch      KnowledgeImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, entityId])
}

model KnowledgeProvenance {
  id               String                @id @default(cuid())
  entityId         String
  sourceId         String
  citation         String
  reviewerStatus   KnowledgeReviewStatus @default(PENDING)
  scientificReview KnowledgeReviewStatus @default(PENDING)
  version          String
  importBatchId    String
  entity           KnowledgeEntity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source           KnowledgeSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([entityId, sourceId, version])
  @@index([importBatchId])
}

model KnowledgeFieldProvenance {
  id               String                @id @default(cuid())
  entityId         String
  fieldPath        String
  claimKey         String
  sourceId         String
  citation         String
  license          String
  reviewerStatus   KnowledgeReviewStatus @default(PENDING)
  scientificReview KnowledgeReviewStatus @default(PENDING)
  languageReview   KnowledgeReviewStatus @default(PENDING)
  geographicScope  String?
  importBatchId    String
  createdAt        DateTime              @default(now())

  @@unique([entityId, fieldPath, sourceId, importBatchId])
  @@index([importBatchId])
}

model KnowledgeImageRights {
  id              String                @id @default(cuid())
  entityId        String
  imageSource     String
  owner           String
  license         String
  attributionText String?
  permittedUse    String
  originalUrl     String
  checksum        String                @unique
  approvalStatus  KnowledgeReviewStatus @default(PENDING)
  reviewerNotes   String?
  createdAt       DateTime              @default(now())

  @@index([entityId])
  @@index([approvalStatus])
}

model Product {
  id                   String                    @id
  legacyId             Int?                      @unique
  category             String
  nameAr               String
  nameEn               String
  shortDescription     String
  description          String
  composition          String
  dosage               String
  packageSize          String
  price                Decimal                   @default(0) @db.Decimal(10, 2)
  comparePrice         Decimal?                  @db.Decimal(10, 2)
  benefits             Json
  crops                Json
  createdByUserId      String
  updatedByUserId      String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  entity               KnowledgeEntity           @relation(fields: [id], references: [id], onDelete: Restrict)
  createdBy            User                      @relation("ProductCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy            User?                     @relation("ProductUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  aliases              ProductAlias[]
  images               ProductImage[]
  recommendations      ProductRecommendation[]
  syncState            ProductKnowledgeSync?
  favoritedByCustomers CustomerProductFavorite[]
  orderItems           OrderItem[]

  @@index([category])
  @@index([createdByUserId])
}

model ProductAlias {
  id              String  @id @default(cuid())
  productId       String
  value           String
  normalizedValue String
  locale          String?
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, normalizedValue])
  @@index([normalizedValue])
}

model ProductImage {
  id             String               @id @default(cuid())
  productId      String
  ownership      ProductImageOwnership
  storageKey     String?              @unique
  url            String
  originalUrl    String?
  thumbnailUrl   String?
  webpUrl        String?
  avifUrl        String?
  blurDataUrl    String?
  alt            String
  contentType    String?
  fileSize       Int?
  width          Int?
  height         Int?
  checksum       String?
  sortOrder      Int
  isPrimary      Boolean              @default(false)
  objectFit      ProductImageFit      @default(CONTAIN)
  objectPosition ProductImagePosition @default(CENTER)
  zoom           Int                  @default(100)
  cropX          Int                  @default(50)
  cropY          Int                  @default(50)
  rotation       Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductRecommendation {
  id                String                          @id @default(cuid())
  productId         String
  targetType        ProductRecommendationTargetType
  plantId           String?
  diseaseId         String?
  pestId            String?
  deficiencyId      String?
  state             ProductRecommendationState      @default(ACTIVE)
  priority          ProductRecommendationPriority   @default(NORMAL)
  usageContext      String?
  compatibility     String?
  contraindications String?
  notes             String?
  product           Product                         @relation(fields: [productId], references: [id], onDelete: Cascade)
  plant             Plant?                          @relation(fields: [plantId], references: [id], onDelete: Cascade)
  disease           Disease?                        @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  pest              Pest?                           @relation(fields: [pestId], references: [id], onDelete: Cascade)
  deficiency        Deficiency?                     @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)

  @@index([targetType])
  @@index([plantId])
  @@index([diseaseId])
  @@index([pestId])
  @@index([deficiencyId])
}

model ProductKnowledgeSync {
  productId      String              @id
  status         KnowledgeSyncStatus @default(PENDING)
  lastSyncedAt   DateTime?
  diagnosticCode String?
  updatedAt      DateTime            @updatedAt
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
}

model KnowledgeRelease {
  id               String                   @id @default(cuid())
  version          String                   @unique
  generation       Int                      @unique
  status           KnowledgeReleaseStatus   @default(GENERATING)
  contentChecksum  String?
  manifestChecksum String?                  @unique
  failureReason    String?
  createdAt        DateTime                 @default(now())
  activatedAt      DateTime?
  activeIn         KnowledgeGenerationLock? @relation("ActiveKnowledgeRelease")

  @@index([status])
  @@index([contentChecksum])
}

model KnowledgeGenerationLock {
  id               String            @id
  ownerToken       String?
  expiresAt        DateTime?
  latestGeneration Int               @default(0)
  activeReleaseId  String?           @unique
  updatedAt        DateTime          @updatedAt
  activeRelease    KnowledgeRelease? @relation("ActiveKnowledgeRelease", fields: [activeReleaseId], references: [id])
}

// Customer identity is intentionally a separate domain. Staff users must never be
// granted customer permissions by role, or share a session/token table with them.
enum CustomerTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CustomerJobType {
  DATA_EXPORT
  ACCOUNT_DELETION
}

enum CustomerJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CustomerAnalyticsEventType {
  PAGE_VIEW
  DOCTOR_STARTED
  DOCTOR_COMPLETED
  PRODUCT_VIEWED
  FAVORITE_CHANGED
  ACCOUNT_CREATED
}

model Customer {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  passwordHash        String
  displayName         String
  locale              String                    @default("ar-EG")
  emailVerifiedAt     DateTime?
  active              Boolean                   @default(true)
  historyOptIn        Boolean                   @default(false)
  imageSavingOptIn    Boolean                   @default(false)
  analyticsOptIn      Boolean                   @default(false)
  marketingOptIn      Boolean                   @default(false)
  deletionRequestedAt DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  sessions            CustomerSession[]
  tokens              CustomerToken[]
  diagnoses           CustomerDiagnosis[]
  savedPlants         CustomerSavedPlant[]
  productFavorites    CustomerProductFavorite[]
  savedImages         CustomerSavedImage[]
  jobs                CustomerJob[]
  auditLogs           CustomerAuditLog[]
  addresses           CustomerAddress[]
  orders              Order[]

  @@index([active])
  @@index([createdAt])
}

model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  userAgent  String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
}

model CustomerToken {
  id         String               @id @default(cuid())
  customerId String
  purpose    CustomerTokenPurpose
  tokenHash  String               @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime             @default(now())
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose, expiresAt])
}

model CustomerDiagnosis {
  id         String   @id @default(cuid())
  customerId String
  // Structured outcome only: raw chat messages and temporary image references are forbidden.
  summary    Json
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model CustomerSavedPlant {
  customerId String
  plantId    String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plant      Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@id([customerId, plantId])
  @@index([plantId])
}

model CustomerProductFavorite {
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@index([productId])
}

model CustomerSavedImage {
  id          String   @id @default(cuid())
  customerId  String
  storageKey  String   @unique
  contentType String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([customerId])
}

model CustomerJob {
  id          String            @id @default(cuid())
  customerId  String?
  type        CustomerJobType
  status      CustomerJobStatus @default(PENDING)
  result      Json?
  errorCode   String?
  createdAt   DateTime          @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([customerId, type])
}

model CustomerAuditLog {
  id         String    @id @default(cuid())
  customerId String?
  actorType  String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([action, createdAt])
}

model AnalyticsEvent {
  id              String                     @id @default(cuid())
  eventType       CustomerAnalyticsEventType
  occurredAt      DateTime                   @default(now())
  anonymousIdHash String
  locale          String?
  route           String?
  // Non-identifying, whitelisted dimensions only. Never messages, images, email, or IP.
  dimensions      Json?

  @@index([eventType, occurredAt])
  @@index([occurredAt])
}

model AnalyticsDailyRollup {
  id        String                     @id @default(cuid())
  date      DateTime
  eventType CustomerAnalyticsEventType
  locale    String                     @default("all")
  count     Int
  updatedAt DateTime                   @updatedAt

  @@unique([date, eventType, locale])
  @@index([date])
}

// Commerce domain: customer addresses, orders, order items, and payment state.
enum CustomerAddressType {
  HOME
  WORK
  FARM
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderPaymentMethod {
  CASH_ON_DELIVERY
  VODAFONE_CASH
  INSTAPAY
  BANK_TRANSFER
  ONLINE_PAYMENT
  OTHER
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderSource {
  WEBSITE
  WHATSAPP
  ADMIN
  PHONE
}

model CustomerAddress {
  id               String              @id @default(cuid())
  customerId       String
  type             CustomerAddressType @default(HOME)
  label            String?
  recipientName    String
  phone            String
  alternativePhone String?
  governorate      String
  city             String
  addressLine      String
  landmark         String?
  postalCode       String?
  isDefault        Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@index([customerId])
  @@index([customerId, isDefault])
}

model Order {
  id               String             @id @default(cuid())
  orderNumber      String             @unique
  customerId       String?
  addressId        String?
  status           OrderStatus        @default(PENDING)
  paymentMethod    OrderPaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus    OrderPaymentStatus @default(PENDING)
  source           OrderSource        @default(WEBSITE)
  customerName     String
  phone            String
  alternativePhone String?
  governorate      String
  city             String
  addressLine      String
  landmark         String?
  notes            String?
  totalItems       Int
  adminNotes       String?
  confirmedAt      DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  customer         Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address          CustomerAddress?   @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@index([customerId])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  productSlug   String
  productNameAr String
  productNameEn String
  productImage  String?
  category      String?
  packageSize   String?
  quantity      Int
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([productSlug])
}
