NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_USER_DIRECTORY=json
# Use a pooled TCP PostgreSQL URL (for example Neon or Prisma Postgres) at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/artvert?sslmode=require
# Use a direct PostgreSQL URL for Prisma migrations. It may equal DATABASE_URL locally.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/artvert?sslmode=require
# Development writes immutable releases below data/generated/knowledge.
KNOWLEDGE_EXPORT_STORE=filesystem
